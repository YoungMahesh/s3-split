{
  "name": "s3-split",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenvx run -- next dev",
    "build": "dotenvx run -- next build",
    "start": "dotenvx run -- next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "dotenvx run -- vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "dotenvx run -- vitest run --project integration",
    "test:watch": "dotenvx run -- vitest",
    "db-generate": "dotenvx run -- drizzle-kit generate",
    "db-migrate": "dotenvx run -- drizzle-kit migrate"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.23.0",
    "better-auth": "^1.7.3",
    "drizzle-orm": "1.0.0-rc.4",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.31.0"
}
